Options +ExecCGI
AddHandler cgi-script .py

RewriteEngine On
RewriteBase /

# 1. Forward Django routes (shop, admin, swagger, redoc) to index.py CGI handler
RewriteCond %{REQUEST_URI} ^/(shop|admin|swagger|redoc)
RewriteRule ^(.*)$ index.py/$1 [QSA,L]

# 2. Serve static React files directly if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

# 3. Fallback for all other routes to React's index.html
RewriteRule ^ index.html [L]
